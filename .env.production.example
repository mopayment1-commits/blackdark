# BLACKDARK — Production environment (Railway / VPS)
# Copy to Railway Variables. NEVER commit real secrets.

PORT=8080
APP_BASE_URL=https://blackdark-production.up.railway.app

# ── Required for launch ──
SECRETS_MASTER_KEY=                    # openssl rand -hex 32
SESSION_TOKEN_PEPPER=                  # openssl rand -hex 16
ADMIN_API_KEY=                         # openssl rand -hex 24
ADMIN_EMAILS=you@yourdomain.com

# ── Stripe (live) — or Lemon Squeezy if Stripe unavailable in your country ──
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_WHALE=price_
STRIPE_SUCCESS_URL=https://blackdark-production.up.railway.app/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://blackdark-production.up.railway.app/cancel

# Lemon Squeezy (Egypt-friendly MoR — set instead of Stripe keys)
LEMON_SQUEEZY_CHECKOUT_PRO=https://blackdark.lemonsqueezy.com/checkout/buy/d044fb7a-5722-498a-885b-dfd04fb7ed05

# ── Telegram alerts ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=https://blackdark-production.up.railway.app/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
# Leave unset to auto-enable long-polling when only TELEGRAM_BOT_TOKEN is set:
# TELEGRAM_POLLING_ENABLED=true
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_FREE_ALERTS_ENABLED=true

# ── Uptime (DD #1) ──
UPTIME_SELF_PROBE_ENABLED=true
UPTIME_SELF_PROBE_INTERVAL_SEC=60

# ── Oracle on Railway cloud ──
PRICE_FEED_WS_ONLY=false

# ── Database (Railway Postgres plugin — optional) ──
DATABASE_URL=postgresql://user:pass@host:5432/blackdark
REDIS_URL=

# Run: python scripts/setup_production_launch.py
# GTM:  python scripts/setup_stripe_production.py && python scripts/setup_telegram_production.py
