# BLACKDARK — Production environment (Railway / VPS)
# Copy ALL variables to Railway Dashboard -> Variables. NEVER commit real secrets.

PORT=8080
APP_BASE_URL=https://blackdark-production.up.railway.app
ENV=production

# ── ARC recommendations (required) ──
SERVICE_MODE=web
DATABASE_URL=postgresql://user:pass@host:5432/railway
LEMON_SQUEEZY_CHECKOUT_PRO=https://blackdark.lemonsqueezy.com/checkout/buy/d044fb7a-5722-498a-885b-dfd04fb7ed05
LEMON_SQUEEZY_CHECKOUT_WHALE=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_CUSTOMER_PORTAL_URL=
# Billing currency is USD for all self-serve SKUs (Decision Pro $29 / Whale Desk $199)

# ── Required for launch ──
SECRETS_MASTER_KEY=                    # openssl rand -hex 32
SESSION_TOKEN_PEPPER=                  # openssl rand -hex 16
ADMIN_API_KEY=                         # openssl rand -hex 24
ADMIN_EMAILS=mopayment1@gmail.com
ADMIN_MFA_REQUIRED=true
ADMIN_TOTP_SECRET=                     # python -c "import pyotp; print(pyotp.random_base32())"
ALLOWED_HOSTS=blackdark-production.up.railway.app
CORS_ALLOWED_ORIGINS=https://blackdark-production.up.railway.app
EXPOSE_B2B_DEMO_KEY=false

# ── Enterprise SSO (Auth0) — SEC-006 ──
ENTERPRISE_OIDC_ISSUER=https://YOUR-TENANT.us.auth0.com
ENTERPRISE_OIDC_CLIENT_ID=
ENTERPRISE_OIDC_CLIENT_SECRET=
ENTERPRISE_SSO_DEMO=false
ENTERPRISE_SSO_DEFAULT_ORG_ID=
ENTERPRISE_SSO_BOOTSTRAP_OWNER_EMAIL=mopayment1@gmail.com
ENTERPRISE_SSO_BOOTSTRAP_ORG_NAME=BLACKDARK Enterprise
# ── Didit KYC (COM-KYC) ──
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
# Didit webhook destination URL: https://blackdark-production.up.railway.app/api/webhooks/didit
# Subscribe to: status.updated, data.updated
# Soft Launch must stay UNSET for institutional / viral HA security bar
# LIVE_EXECUTION_ALLOW_API must stay unset/false unless intentionally live
# Edge: docs/CDN_WAF_CHECKLIST.md · Backups: scripts/backup_postgres.py
# Max audit: python scripts/security_max_audit.py

# ── Redis (Railway Redis plugin or Upstash) — REQUIRED for viral HA ──
REDIS_URL=redis://default:pass@host:6379
SERVICE_BUS_LOCAL=false

# ── Viral launch capacity (REQUIRED for spike-safe production) ──
# Soft Launch must be UNSET (do not set SOFT_LAUNCH=true)
VIRAL_MODE=true
WEB_CONCURRENCY=4
WEB_REPLICAS=2
PG_POOL_MIN=4
PG_POOL_MAX=40
VIRAL_MAX_INFLIGHT=200
VIRAL_ORACLE_CONCURRENCY=32
VIRAL_ORACLE_RL_PER_MIN=60
VIRAL_AUTH_RL_PER_MIN=30
VIRAL_API_RL_PER_MIN=120
VIRAL_QUICK_CACHE_TTL_SEC=2
# Verify: GET /api/viral/readiness  GET /health/viral
# Playbook: docs/VIRAL_LAUNCH_CAPACITY.md

# ── Observability ──
SENTRY_DSN=                            # https://sentry.io project DSN
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Stripe (optional if Lemon Squeezy set) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_WHALE=
STRIPE_SUCCESS_URL=https://blackdark-production.up.railway.app/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://blackdark-production.up.railway.app/cancel

# ── Telegram alerts ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=https://blackdark-production.up.railway.app/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_FREE_ALERTS_ENABLED=true

# ── Uptime (DD #1) ──
UPTIME_SELF_PROBE_ENABLED=true
UPTIME_SELF_PROBE_INTERVAL_SEC=60
# External: UptimeRobot -> https://blackdark-production.up.railway.app/health/live every 5 min

# ── Oracle on Railway cloud ──
PRICE_FEED_WS_ONLY=false

# Run: python scripts/setup_production_launch.py
# Verify: GET /api/production/guard  GET /api/viral/readiness  GET /health/viral
# Load proof: python scripts/load_test_concurrent.py --base $APP_BASE_URL --workers 40 --requests 200

# ── Identity / OAuth (optional but recommended) ──
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
IDENTITY_DEBUG_TOKENS=false

# ── Site companion / trust rail ──
BRAND_SOCIAL_X=https://x.com/blackdark
BRAND_SOCIAL_TELEGRAM=https://t.me/blackdark
BRAND_SOCIAL_LINKEDIN=https://www.linkedin.com/company/blackdark
SUPPORT_EMAIL=support@blackdark.app
COMPLAINTS_EMAIL=complaints@blackdark.app
SALES_EMAIL=sales@blackdark.io
# WHATSAPP_BUSINESS_E164=
# INSTITUTIONAL_PHONE=
