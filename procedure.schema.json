{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BLACKDARK Procedure Record",
  "type": "object",
  "required": [
    "procedure_id",
    "requirement_id",
    "universe_ids",
    "domain",
    "risk_level",
    "applicability_status",
    "execution_class",
    "objective",
    "population_denominator",
    "method",
    "minimum_evidence_class",
    "acceptance_criteria",
    "failure_criteria",
    "status"
  ],
  "properties": {
    "procedure_id": {
      "type": "string",
      "pattern": "^PROC-[A-Z0-9_-]+$"
    },
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "universe_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "applicability_status": {
      "enum": [
        "DIRECTLY_APPLICABLE",
        "CONTRACTUALLY_APPLICABLE",
        "INSTITUTIONAL_BENCHMARK",
        "TECHNICAL_BENCHMARK",
        "NOT_APPLICABLE",
        "APPLICABILITY_NOT_VERIFIED"
      ]
    },
    "execution_class": {
      "enum": [
        "LOCAL_EXECUTABLE",
        "STAGING_REQUIRED",
        "PROD_READ_ONLY_REQUIRED",
        "CI_CONTROL_PLANE_REQUIRED",
        "EXTERNAL_HUMAN_REQUIRED"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "population_denominator": {
      "type": [
        "integer",
        "string"
      ],
      "minLength": 1
    },
    "method": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "EXAMINE",
          "INTERVIEW",
          "TEST",
          "RECOMPUTE",
          "TRACE",
          "RECONCILE",
          "OBSERVE",
          "CHALLENGE",
          "MEASURE"
        ]
      }
    },
    "minimum_evidence_class": {
      "enum": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "acceptance_criteria": {
      "type": "string",
      "minLength": 1
    },
    "failure_criteria": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "PASS",
        "FAIL",
        "PARTIAL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker_id": {
      "type": "string"
    },
    "na_reason": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}