{
  "name": "BLACKDARK Cloud",
  "version": "1.0.0",
  "description": "HaasCloud-style multi-service deploy manifest for BLACKDARK",
  "services": [
    {
      "id": "web",
      "role": "api_ui",
      "port": 8080,
      "health": "/health/live",
      "scale": { "min": 1, "max": 10 },
      "env": ["DATABASE_URL", "REDIS_URL", "KAFKA_BROKERS", "VAULT_ADDR"]
    },
    {
      "id": "aggregator",
      "role": "market_worker",
      "port": 8091,
      "health": "/health/live",
      "scale": { "min": 1, "max": 5 }
    },
    {
      "id": "arbitrage",
      "role": "execution_worker",
      "port": 8092,
      "health": "/health/live",
      "scale": { "min": 1, "max": 8 }
    },
    {
      "id": "ingestion",
      "role": "data_lake",
      "port": 8093,
      "health": "/health/live",
      "scale": { "min": 1, "max": 3 }
    }
  ],
  "infrastructure": {
    "postgresql": { "required": true, "compose_service": "postgres" },
    "redis": { "required": true, "compose_service": "redis" },
    "kafka": { "required": false, "compose_service": "kafka" },
    "vault": { "required": false, "compose_service": "vault" }
  },
  "deploy": {
    "local": "docker compose up -d --build",
    "railway": "railway.json + Dockerfile",
    "launcher": "python run_service.py all --port 8080"
  }
}
