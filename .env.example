# BLACKDARK — Environment Variables
# Copy to .env and fill in keys (free tiers linked in DEPLOY.md)

PORT=8080

# ── Data ingestion architecture ─────────────────────────────────────────────
INGESTION_ENABLED=true
INGESTION_BOOTSTRAP_ON_START=true
FORECAST_ENABLED=true
FORECAST_AUDIT_INTERVAL_SEC=3600
ORACLE_DATA_HUB_ENABLED=true
RUN_AGGREGATOR=true
MANIFEST_AUTO_APPROVE=true
MANIFEST_REQUIRE_REVIEW=false
UNIVERSE_AUTO_ACTIVATE=true
MANIFEST_REQUIRE_REVIEW=false

# Live WebSocket → hot_spool (Binance trades)
BINANCE_WS_ENABLED=true
BINANCE_WS_SYMBOLS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,AVAX,LINK,DOT

# ── Free LLM chain (Oracle sentences) ───────────────────────────────────────
AI_ORACLE_PROVIDER=free_chain
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Prices & aggregators ────────────────────────────────────────────────────
COINMARKETCAP_API_KEY=
SENTIMENT_CRYPTOCOMPARE_API_KEY=
COINAPI_KEY=

# ── On-chain explorers ──────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=
BLOCKCHAIR_API_KEY=
GLASSNODE_API_KEY=

# ── DeFi ────────────────────────────────────────────────────────────────────
ONEINCH_API_KEY=

# ── News & sentiment ────────────────────────────────────────────────────────
CRYPTOPANIC_API_KEY=
NEWSAPI_KEY=
LUNARCRUSH_API_KEY=             # optional — socialtickers free fallback in bd_platform
TWITTER_BEARER_TOKEN=

# ── Events & whale tracking ─────────────────────────────────────────────────
COINMARKETCAL_API_KEY=
WHALE_ALERT_API_KEY=
DEBANK_API_KEY=
CRYPTOQUANT_API_KEY=

# ── Macro traditional finance ───────────────────────────────────────────────
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPENEXCHANGERATES_APP_ID=
TWELVEDATA_API_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SESSION_DAYS=30
PRO_TRIAL_DAYS=7

# ── Stripe (paid tiers) ─────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_WHALE=
STRIPE_SUCCESS_URL=http://localhost:8080/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8080/cancel

# ── B2B institutional feed ──────────────────────────────────────────────────
BLACKDARK_B2B_API_KEY=
BLACKDARK_B2B_DEMO_KEY=disabled
B2B_WS_ENABLED=true
B2B_WS_HEARTBEAT_SEC=15
B2B_WS_EVENT_COOLDOWN_SEC=3
B2B_WS_LATENCY_TARGET_MS=500
B2B_WS_MAX_CONNECTIONS=50

# ── Telegram alerts ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_ALERT_INTERVAL_SECONDS=5
TELEGRAM_FREE_ALERTS_ENABLED=true
TELEGRAM_FREE_DAILY_LIMIT=3
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_BOT_USERNAME=

# Instant market pulse (arbitrage scan + Telegram on hot opportunities)
INSTANT_ALERTS_ENABLED=true
INSTANT_ALERT_INTERVAL_SEC=2
INSTANT_ALERT_COOLDOWN_SEC=45
INSTANT_ALERT_MIN_PROFIT_USDT=0.15
POLL_INTERVAL_SECONDS=3
ARBITRAGE_PREFER_LIVE=false
MARKET_CACHE_TTL_SEC=2
SCAN_CACHE_TTL_SEC=1
LIVE_FETCH_STALE_THRESHOLD_SEC=8
LIVE_FETCH_TIMEOUT_SEC=4
LIVE_FETCH_FAST_DEADLINE_SEC=2.5
FAST_LIVE_EXCHANGES=binance,okx,bybit,kraken,coinbase

# ── Microservices (scalable architecture) ────────────────────────────────────
SERVICE_MODE=all
REDIS_URL=redis://localhost:6379/0
SERVICE_BUS_LOCAL=true
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=blackdark-workers
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=blackdark-dev-root
VAULT_DEV_TOKEN=blackdark-dev-root
VAULT_KV_MOUNT=secret
# Production PostgreSQL (docker compose postgres service):
# DATABASE_URL=postgresql://blackdark:YOUR_PASSWORD@localhost:5432/blackdark
# PG_POOL_MAX=20
SENTIMENT_TWITTER_FALLBACK=true

# Low Latency Engine — WebSocket order books → arbitrage bot
LOW_LATENCY_MODE=true
EXCHANGE_WS_ENABLED=true
LIVE_BOOK_MAX_AGE_MS=500
AUTO_EXECUTION_LOOP=true
AUTO_EXECUTION_DRY_RUN=true
AUTO_EXECUTION_INTERVAL_SEC=5
AUTO_EXECUTION_MIN_PROFIT_USDT=0.25
AUTO_EXECUTION_QUOTE_USD=100
# Live orders (real profit): AUTO_EXECUTION_ENABLED=true + BINANCE_API_KEY/SECRET
# CEX↔DEX: CEX_DEX_EXECUTION_ENABLED=true · CEX_DEX_AUTO_EXEC=false · CEX_DEX_QUOTE_USD=500
CEX_DEX_EXECUTION_ENABLED=true
CEX_DEX_AUTO_EXEC=false
CEX_DEX_MIN_NET_BPS=8
CEX_DEX_QUOTE_USD=500
ML_DRIFT_PSI_THRESHOLD=0.25
ML_OOD_REJECT_THRESHOLD=0.65
ARBITRAGE_ALERT_MIN_PROFIT_PCT=0.05
ARBITRAGE_ALERT_MIN_PROFIT_USDT=0.10

# ── Email alerts (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Auto-execution (default OFF) ────────────────────────────────────────────
AUTO_EXECUTION_ENABLED=false
AUTO_EXECUTION_LOOP=false
AUTO_EXECUTION_INTERVAL_SEC=120
AUTO_EXECUTION_MIN_PROFIT_USDT=0.25
AUTO_EXECUTION_QUOTE_USD=100
BINANCE_TESTNET=false

# ── Weekly report scheduler ─────────────────────────────────────────────────
WEEKLY_REPORT_AUTO=false
WEEKLY_REPORT_INTERVAL_HOURS=168

# ── Daily report scheduler ────────────────────────────────────────────────────
DAILY_REPORT_AUTO=false
DAILY_REPORT_INTERVAL_HOURS=24

CCXT_SYMBOL_LIMIT=25
COINGECKO_SYMBOL_LIMIT=10
DEX_SYMBOL_LIMIT=15
PERP_DEX_SYMBOL_LIMIT=15
ML_FLYWHEEL_ENABLED=true
ML_FLYWHEEL_INTERVAL_SEC=3600
ML_MIN_TRAIN_SAMPLES=50
ML_AUTO_TRAIN=true

# ── Security (production required) — see docs/SECURITY_CATASTROPHE_P0_AR.md ──
SECRETS_MASTER_KEY=
SESSION_TOKEN_PEPPER=
ADMIN_API_KEY=
# ADMIN_API_KEY_FILE=
ADMIN_EMAILS=
ADMIN_MFA_REQUIRED=true
ADMIN_TOTP_SECRET=
TELEGRAM_WEBHOOK_SECRET=
POSTGRES_PASSWORD=
EXPOSE_B2B_DEMO_KEY=false
BLACKDARK_B2B_DEMO_KEY=disabled
LIVE_EXECUTION_ALLOW_API=false
JUPITER_LIVE_EXECUTION=false
# Strict production operator declarations (fail-closed when SOFT_LAUNCH unset):
# CDN_WAF_ACTIVE=true
# CLOUDFLARE_ZONE_ID=
# BACKUP_SCHEDULE_CONFIGURED=true
# SENTRY_DSN=
# EXTERNAL_UPTIME_CONFIGURED=true
PRODUCTION_GUARD_FAIL_CLOSED=true
RISK_MAX_SLIPPAGE_BPS=80
RISK_POISON_PRICE_DEVIATION_PCT=15
RISK_POISON_FREEZE_SEC=300
RISK_STOP_LOSS_PCT=2.0
SENTIMENT_GATE_ENABLED=true
SENTIMENT_FEAR_BLOCK_THRESHOLD=-0.65

# Twitter/X real API (set mock=false + token for production)
SENTIMENT_TWITTER_MOCK_ENABLED=false
DB_RETENTION_DAYS=30
DB_MAINTENANCE_AUTO=false
DB_MAINTENANCE_INTERVAL_HOURS=24
DB_MAINTENANCE_PRUNE=true
DB_BACKUP_ON_MAINTENANCE=false
# Leave empty for SQLite (local dev). Set postgresql://... for production.
DATABASE_URL=
HOT_STORAGE_TIMESCALE_DSN=

# ── Viral / concurrent capacity (production HA — see docs/VIRAL_LAUNCH_CAPACITY.md) ──
# Soft Launch + SQLite ≠ viral. For viral: Postgres + Redis + unset SOFT_LAUNCH.
VIRAL_MODE=true
WEB_CONCURRENCY=1
WEB_REPLICAS=1
# VIRAL_MAX_INFLIGHT=200
# VIRAL_ORACLE_CONCURRENCY=32
# REDIS_URL=redis://127.0.0.1:6379/0
# SERVICE_BUS_LOCAL=false

# ── Cloud sync (Point 40) ───────────────────────────────────────────────────
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_INTERVAL_HOURS=6
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PREFIX=blackdark/historical

# ── Oracle weight retrain (Point 47) ─────────────────────────────────────────
ORACLE_RETRAIN_ENABLED=true
MODEL_WEIGHTS_KEY=

BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── OpenAI (optional — chat + sentiment) ──────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Platform 40-point integrations (bd_platform/) ───────────────────────────
COINGLASS_API_KEY=              # optional — #7/#10 Binance free fallback works without key
CRYPTORANK_API_KEY=             # optional — token unlocks use CoinGecko free fallback
LUNARCRUSH_API_KEY=             # optional — #17 socialtickers free fallback (Hobby API: market data 100/day)
COINMARKETCAL_API_KEY=          # optional free key at developers.coinmarketcal.com — #18
DEBANK_API_KEY=                 # optional paid — #19 Tracely portfolio free fallback
ZERION_API_KEY=                 # optional free ~3k/day at zerion.io — #19 wallet enhancement
BUBBLEMAPS_API_KEY=             # optional paid — #20 Tracely clusters free fallback
SCOPESCAN_API_KEY=              # optional paid — #24 Tracely+eth-labels free fallback
BLOCKPOUR_API_KEY=              # optional free key at app.blockpour.com — #32 DeFiLlama fallback
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_DEFAULT_USD=100
ML_OOD_FAIL_CLOSED=true
RISK_MAX_DRAWDOWN_PCT=8.0

# ── USD Billing (Trust OS) ──
# Currency: USD only. Never store card PAN/CVV on this app.
