# BLACKDARK — Environment Variables
# Copy to .env and fill in keys (free tiers linked in DEPLOY.md)

PORT=8080

# ── Data ingestion architecture ─────────────────────────────────────────────
INGESTION_ENABLED=true
INGESTION_BOOTSTRAP_ON_START=true
FORECAST_ENABLED=true
FORECAST_AUDIT_INTERVAL_SEC=3600
ORACLE_DATA_HUB_ENABLED=true
RUN_AGGREGATOR=true
MANIFEST_AUTO_APPROVE=true
MANIFEST_REQUIRE_REVIEW=false

# Live WebSocket → hot_spool (Binance trades)
BINANCE_WS_ENABLED=true
BINANCE_WS_SYMBOLS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE,AVAX,LINK,DOT

# ── Free LLM chain (Oracle sentences) ───────────────────────────────────────
AI_ORACLE_PROVIDER=free_chain
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Prices & aggregators ────────────────────────────────────────────────────
COINMARKETCAP_API_KEY=
SENTIMENT_CRYPTOCOMPARE_API_KEY=
COINAPI_KEY=

# ── On-chain explorers ──────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=
BLOCKCHAIR_API_KEY=
GLASSNODE_API_KEY=

# ── DeFi ────────────────────────────────────────────────────────────────────
ONEINCH_API_KEY=

# ── News & sentiment ────────────────────────────────────────────────────────
CRYPTOPANIC_API_KEY=
NEWSAPI_KEY=
LUNARCRUSH_API_KEY=
TWITTER_BEARER_TOKEN=

# ── Events & whale tracking ─────────────────────────────────────────────────
COINMARKETCAL_API_KEY=
WHALE_ALERT_API_KEY=
DEBANK_API_KEY=
CRYPTOQUANT_API_KEY=

# ── Macro traditional finance ───────────────────────────────────────────────
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
OPENEXCHANGERATES_APP_ID=
TWELVEDATA_API_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SESSION_DAYS=30
PRO_TRIAL_DAYS=7

# ── Stripe (paid tiers) ─────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_WHALE=
STRIPE_SUCCESS_URL=http://localhost:8080/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8080/cancel

# ── B2B institutional feed ──────────────────────────────────────────────────
BLACKDARK_B2B_API_KEY=
BLACKDARK_B2B_DEMO_KEY=bd_demo_launch_2026

# ── Telegram alerts ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_ALERT_INTERVAL_SECONDS=90
ARBITRAGE_ALERT_MIN_PROFIT_PCT=0.05
ARBITRAGE_ALERT_MIN_PROFIT_USDT=0.10

# ── Email alerts (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Auto-execution (default OFF) ────────────────────────────────────────────
AUTO_EXECUTION_ENABLED=false
AUTO_EXECUTION_LOOP=false
AUTO_EXECUTION_INTERVAL_SEC=120
AUTO_EXECUTION_MIN_PROFIT_USDT=0.25
AUTO_EXECUTION_QUOTE_USD=100
BINANCE_TESTNET=false

# ── Weekly report scheduler ─────────────────────────────────────────────────
WEEKLY_REPORT_AUTO=false
WEEKLY_REPORT_INTERVAL_HOURS=168

# ── Daily report scheduler ────────────────────────────────────────────────────
DAILY_REPORT_AUTO=false
DAILY_REPORT_INTERVAL_HOURS=24

CCXT_SYMBOL_LIMIT=25
COINGECKO_SYMBOL_LIMIT=10
DEX_SYMBOL_LIMIT=15
PERP_DEX_SYMBOL_LIMIT=15

# ── Database maintenance (Priority 5) ───────────────────────────────────────
DB_RETENTION_DAYS=30
DB_MAINTENANCE_AUTO=false
DB_MAINTENANCE_INTERVAL_HOURS=24
DB_MAINTENANCE_PRUNE=true
DB_BACKUP_ON_MAINTENANCE=false
DATABASE_URL=
HOT_STORAGE_TIMESCALE_DSN=

# ── Cloud sync (Point 40) ───────────────────────────────────────────────────
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_INTERVAL_HOURS=6
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PREFIX=blackdark/historical

# ── Oracle weight retrain (Point 47) ─────────────────────────────────────────
ORACLE_RETRAIN_ENABLED=true
MODEL_WEIGHTS_KEY=

BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── OpenAI (optional — chat + sentiment) ──────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
