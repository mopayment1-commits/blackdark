# Railway / production environment variables

PORT=8080



# Background data ingestion (Binance + OKX + Bybit every 5s)

RUN_AGGREGATOR=true

MANIFEST_AUTO_APPROVE=true

MANIFEST_REQUIRE_REVIEW=false



# Auth sessions (change in production!)

AUTH_SESSION_DAYS=30



# Stripe — required for paid tiers

STRIPE_SECRET_KEY=

STRIPE_WEBHOOK_SECRET=

STRIPE_SUCCESS_URL=https://YOUR-DOMAIN/success?session_id={CHECKOUT_SESSION_ID}

STRIPE_CANCEL_URL=https://YOUR-DOMAIN/cancel



# B2B institutional feed
BLACKDARK_B2B_API_KEY=
BLACKDARK_B2B_DEMO_KEY=bd_demo_launch_2026

# Launch trial (days on signup + Stripe checkout)
PRO_TRIAL_DAYS=7



# Alerts — Telegram

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=

TELEGRAM_ALERTS_ENABLED=true

TELEGRAM_ALERT_INTERVAL_SECONDS=90

ARBITRAGE_ALERT_MIN_PROFIT_PCT=0.05

ARBITRAGE_ALERT_MIN_PROFIT_USDT=0.10



# Email alerts (SMTP)

SMTP_HOST=

SMTP_PORT=587

SMTP_USER=

SMTP_PASSWORD=

SMTP_FROM=



# Auto-execution (default OFF — dry-run only)

AUTO_EXECUTION_ENABLED=false

BINANCE_API_KEY=

BINANCE_API_SECRET=

