  "attribution_rules": {
    "rsi_overbought": {
      "rule_id": "rsi_overbought",
      "template": "IF RSI(14) > {threshold} AND Volume > {volume_mult}x average THEN Signal=Overbought",
      "threshold": 70,
      "volume_mult": 1.5,
      "trigger_metric": "RSI"
    },
    "rsi_oversold": {
      "rule_id": "rsi_oversold",
      "template": "IF RSI(14) < {threshold} AND Volume > {volume_mult}x average THEN Signal=Oversold",
      "threshold": 30,
      "volume_mult": 1.5,
      "trigger_metric": "RSI"
    },
    "macd_bullish_cross": {
      "rule_id": "macd_bullish_cross",
      "template": "IF MACD line > Signal line AND Histogram > 0 THEN Signal=Bullish",
      "trigger_metric": "MACD"
    }
  },
