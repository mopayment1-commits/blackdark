  "metric_definitions": {
    "active_addresses": {
      "name": "Active Addresses (24h)",
      "formula": "count(distinct addresses with >=1 on-chain tx in rolling 24h window)",
      "formula_version": "1.0",
      "source": "blockchain_indexer",
      "unit": "addresses",
      "update_frequency": "hourly"
    },
    "transaction_count": {
      "name": "Transaction Count (24h)",
      "formula": "sum(confirmed transactions in rolling 24h window)",
      "formula_version": "1.0",
      "source": "blockchain_indexer",
      "unit": "transactions",
      "update_frequency": "hourly"
    },
    "hash_rate": {
      "name": "Network Hash Rate",
      "formula": "mean(block_hash_rate) over trailing 144 blocks",
      "formula_version": "1.0",
      "source": "miner_intelligence_layer",
      "unit": "EH/s",
      "update_frequency": "daily"
    },
    "exchange_netflow": {
      "name": "Exchange Net Flow",
      "formula": "exchange_inflow_usd - exchange_outflow_usd (24h)",
      "formula_version": "1.0",
      "source": "exchange_intelligence_layer",
      "unit": "USD",
      "update_frequency": "hourly"
    },
    "stablecoin_exchange_reserve": {
      "name": "Stablecoin Exchange Reserve",
      "formula": "sum(exchange_wallet_balance * price_usd) per labeled entity",
      "formula_version": "1.0",
      "source": "stablecoin_health_monitor_467",
      "unit": "USD",
      "update_frequency": "hourly",
      "task_ref": 601
    },
    "exchange_stablecoin_buying_power": {
      "name": "Exchange Stablecoin Buying Power Index",
      "formula": "sum(stablecoin_exchange_balances_usd) / sum(crypto_exchange_balances_usd) * 100",
      "formula_version": "1.0",
      "source": "stablecoin_health_monitor_663",
      "unit": "percent",
      "update_frequency": "hourly",
      "task_ref": 663,
      "triple_source": ["defillama", "glassnode", "onchain_direct"]
    },
    "transaction_volume_usd": {
      "name": "Transaction Volume (USD, entity-adjusted)",
      "formula": "sum(usd_value_at_tx_time) excluding spam/internal/self/dust",
      "formula_version": "1.0",
      "source": "blockchain_indexer",
      "unit": "USD",
      "update_frequency": "daily",
      "task_ref": 612
    }
  },
