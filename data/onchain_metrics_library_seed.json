  "methodology_version": "1.0",
  "last_updated": "2026-08-26",
  "metric_definitions": {
    "active_addresses": {
      "name": "Active Addresses (24h)",
      "formula": "count(distinct addresses with >=1 on-chain tx in rolling 24h window)",
      "formula_version": "1.0",
      "source": "blockchain_indexer",
      "unit": "addresses",
      "update_frequency": "hourly"
    },
    "transaction_count": {
      "name": "Transaction Count (24h)",
      "formula": "sum(confirmed transactions in rolling 24h window)",
      "formula_version": "1.0",
      "source": "blockchain_indexer",
      "unit": "transactions",
      "update_frequency": "hourly"
    },
    "hash_rate": {
      "name": "Network Hash Rate",
      "formula": "mean(block_hash_rate) over trailing 144 blocks",
      "formula_version": "1.0",
      "source": "miner_intelligence_layer",
      "unit": "EH/s",
      "update_frequency": "daily"
    },
    "exchange_netflow": {
      "name": "Exchange Net Flow",
      "formula": "exchange_inflow_usd - exchange_outflow_usd (24h)",
      "formula_version": "1.0",
      "source": "exchange_intelligence_layer",
      "unit": "USD",
      "update_frequency": "hourly"
    },
    "stablecoin_exchange_reserve": {
      "name": "Stablecoin Exchange Reserve",
      "formula": "sum(exchange_wallet_balance * price_usd) per labeled entity",
      "formula_version": "1.0",
      "source": "stablecoin_health_monitor_467",
      "unit": "USD",
      "update_frequency": "hourly",
      "task_ref": 601
    },
    "exchange_stablecoin_buying_power": {
      "name": "Exchange Stablecoin Buying Power Index",
      "formula": "sum(stablecoin_exchange_balances_usd) / sum(crypto_exchange_balances_usd) * 100",
      "formula_version": "1.0",
      "source": "stablecoin_health_monitor_663",
      "unit": "percent",
      "update_frequency": "hourly",
      "task_ref": 663,
      "triple_source": ["defillama", "glassnode", "onchain_direct"]
    },
    "long_short_ratio": {
      "name": "Long/Short Ratio",
      "formula": "venue-specific normalized; global = weighted average",
      "formula_version": "1.0",
      "source": "exchange_derivatives_api",
      "unit": "ratio",
      "update_frequency": "hourly",
      "task_ref": 675
    },
    "mvrv_zscore": {
      "name": "MVRV Z-Score Suite",
      "formula": "MVRV = Market Cap / Realized Cap; Z = (MVRV - Mean) / Std",
      "formula_version": "1.0",
      "source": "onchain_metrics_suite_676",
      "unit": "z_score",
      "update_frequency": "daily",
      "task_ref": 676,
      "cohorts": ["sth", "lth", "total"]
    },
    "transaction_volume_usd": {
      "name": "Transaction Volume (USD, entity-adjusted)",
      "formula": "sum(usd_value_at_tx_time) excluding spam/internal/self/dust",
      "formula_version": "1.0",
      "source": "blockchain_indexer",
      "unit": "USD",
      "update_frequency": "daily",
      "task_ref": 612
    },
    "gaming_liquidity": {
      "name": "Gaming Sector Liquidity",
      "formula": "sum(dex_volume_usd) + sum(on_chain_transfer_usd) for gaming-tagged tokens",
      "formula_version": "1.0",
      "source": "dex_volume_feed + on_chain_transfers",
      "unit": "USD",
      "update_frequency": "daily",
      "task_ref": 678
    },
    "ai_token_index": {
      "name": "AI Token Sector Index",
      "formula": "market_cap_weighted_index(ai_token_basket) / baseline",
      "formula_version": "1.0",
      "source": "sector_index_engine",
      "unit": "index",
      "update_frequency": "daily",
      "task_ref": 678
    },
    "rwa_inflows": {
      "name": "RWA Institutional Inflows",
      "formula": "sum(stablecoin_inflow_usd) + sum(institutional_flow_usd) for rwa-tagged assets",
      "formula_version": "1.0",
      "source": "stablecoin_flows + institutional_flow",
      "unit": "USD",
      "update_frequency": "daily",
      "task_ref": 678
    },
    "solana_ecosystem_activity": {
      "name": "Solana Ecosystem Activity",
      "formula": "tx_count_spike_pct + daa_spike_pct + funding_rate_context",
      "formula_version": "1.0",
      "source": "solana_indexer + derivatives_funding",
      "unit": "composite",
      "update_frequency": "hourly",
      "task_ref": 678
    }
  },
