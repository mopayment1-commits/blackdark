  "formula": {
    "description": "Executable net-edge score 0-100 with fail-closed gates",
    "weights": {
      "residual_edge": 0.45,
      "latency_freshness": 0.25,
      "slippage_quality": 0.15,
      "fee_drag_clarity": 0.15
    },
    "capacity_penalty": "0.15 × (100 − liquidity_score) when #415 depth present",
    "truth_edge_usd": "residual_after_crowd − latency_buffer − network_cost",
    "unknown_costs_policy": "worst_case_estimate_never_zero",
    "fail_closed": ["stale_depth", "not_fillable", "negative_net_edge", "unverifiable_economics"]
  },
  "worst_case_costs_default": {
    "withdrawal_fee_usdt": 2.5,
    "trading_fees_usdt": 1.0,
    "transfer_cost_usdt": 0.5
  },
