# Coverage config for SonarCloud import (Cobertura XML).
# Broad production sources — no mass exclusions to inflate %.

[run]
branch = true
source =
    .
omit =
    tests/*
    .venv/*
    venv/*
    scripts/*
    **/__pycache__/*
    setup_*.py
    run_service.py
    alembic/*
    data/*
    ml/train_*.py

[report]
show_missing = true
precision = 1
skip_empty = true
