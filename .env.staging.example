# BLACKDARK — Staging environment (Railway)
# Copy to Railway staging service variables — NEVER commit real secrets.

ENVIRONMENT=staging
RAILWAY_ENVIRONMENT=staging
APP_ENV=staging
SOFT_LAUNCH=true

PORT=8080
SERVICE_MODE=web

# BLK-002 — dedicated staging Postgres (NOT local SQLite)
DATABASE_URL=postgresql://user:password@staging-host:5432/blackdark_staging

REDIS_URL=redis://default:password@staging-redis:6379

# Secrets (generate unique per environment)
SECRETS_MASTER_KEY=
SECRETS_VAULT_KEY=
ADMIN_API_KEY=
JWT_SECRET=

# Billing (test mode on staging)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Monitoring & alerting (post-deploy)
MONITORING_ENABLED=true
MONITORING_BASE_URL=https://your-app.up.railway.app
OPS_TELEGRAM_CHAT_ID=
MONITORING_WEBHOOK_URL=

# Optional data vendors (staging keys only)
GROQ_API_KEY=
ETHERSCAN_API_KEY=
